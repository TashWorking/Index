<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MainsMeals - Food & Travel Community</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f5f5f5;
        }
        header {
            background-image: url('background.jpg'); /* Replace with your background image */
            background-size: cover;
            background-position: center;
            color: white;
            text-align: center;
            padding: 50px;
        }
        header h1 {
            font-size: 3rem;
            margin: 0;
        }
        header p {
            font-size: 1.2rem;
        }
        nav {
            background-color: #333;
            padding: 10px;
            text-align: center;
        }
        nav a {
            color: white;
            padding: 10px 20px;
            text-decoration: none;
            text-transform: uppercase;
            font-weight: bold;
        }
        nav a:hover {
            background-color: #555;
        }
        .intro {
            background-color: #fff;
            padding: 30px;
            margin-top: 30px;
            text-align: center;
        }
        .intro h2 {
            font-size: 2rem;
            color: #333;
        }
        .intro p {
            font-size: 1rem;
            color: #555;
        }
        .gallery {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
            padding: 30px;
        }
        .gallery img {
            width: 300px;
            height: 200px;
            object-fit: cover;
            border-radius: 8px;
        }
        footer {
            background-color: #333;
            color: white;
            text-align: center;
            padding: 15px;
            position: fixed;
            width: 100%;
            bottom: 0;
        }
    </style>
</head>
<body>

    <!-- Header Section -->
    <header>
        <h1>Welcome to MainsMeals</h1>
        <p>Your community space to share food, recipes, and travel stories</p>
    </header>

    <!-- Navigation Bar -->
    <nav>
        <a href="#home">Home</a>
        <a href="#recipes">Recipes</a>
        <a href="#media">Media</a>
        <a href="#connect">Connect</a>
        <a href="#about">About</a>
    </nav>

    <!-- Introductory Message Section -->
    <section class="intro" id="home">
        <h2>Discover, Share & Connect</h2>
        <p>At MainsMeals, we bring together food lovers, recipe sharers, and travelers to explore new tastes and cultures. Whether you're looking for fresh recipes or planning your next adventure, you've found the perfect space to connect with like-minded individuals.</p>
    </section>

    <!-- Gallery Section for Pictures -->
    <section class="gallery" id="media">
        <h2 style="text-align: center; width: 100%;">Gallery</h2>
        <img src="image1.jpg" alt="Food 1"> <!-- Replace with actual image URLs -->
        <img src="image2.jpg" alt="Food 2">
        <img src="image3.jpg" alt="Food 3">
        <img src="image4.jpg" alt="Food 4">
    </section>

    <!-- Footer Section -->
    <footer>
        <p>© 2025 MainsMeals | All Rights Reserved</p>
    </footer>

</body>
</html>
